generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organizations ───────────────────────────────────────────────────────

model Organization {
  id              String   @id @default(uuid())
  name            String
  sizeRange       String?
  locationCountry String?
  locationState   String?
  locationMetro   String?
  locationCity    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users     User[]
  campaigns SurveyCampaign[]

  @@map("organizations")
}

// ─── Users ───────────────────────────────────────────────────────────────

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String?
  passwordHash   String?
  role           String        @default("RESPONDENT") // SUPER_ADMIN | ORG_ADMIN | VIEWER | RESPONDENT
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

// ─── Surveys ──────────────────────────────────────────────────────────────

model Survey {
  id           String  @id @default(uuid())
  title        String
  description  String?
  surveyType   String
  surveyNumber String?

  surveyjsSchema Json

  status    String   @default("DRAFT")
  version   Int      @default(1)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  Section[]
  questions Question[]
  campaigns SurveyCampaign[]
  scale     Scale?           @relation(fields: [scaleId], references: [id])
  scaleId   String?

  @@index([status])
  @@index([surveyType])
  @@map("surveys")
}

model Section {
  id          String   @id @default(uuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]

  @@index([surveyId])
  @@map("sections")
}

model Question {
  id        String   @id @default(uuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  questionNumber Int
  text           String
  questionType   String

  surveyjsName String

  config Json?

  isRequired Boolean @default(true)
  isReversed Boolean @default(false)

  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories QuestionCategory[]

  @@unique([surveyId, questionNumber])
  @@index([surveyId])
  @@index([sectionId])
  @@index([surveyjsName])
  @@map("questions")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  weight      Decimal  @default(1.0) @db.Decimal(4, 2)
  colorCode   String?
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions QuestionCategory[]

  @@map("categories")
}

model QuestionCategory {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([questionId, categoryId])
  @@index([questionId])
  @@index([categoryId])
  @@map("question_categories")
}

model Scale {
  id        String   @id @default(uuid())
  name      String   @unique
  scaleType String
  min       Int
  max       Int
  labels    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  surveys Survey[]

  @@map("scales")
}

// ─── Survey Campaigns ────────────────────────────────────────────────────

model SurveyCampaign {
  id             String       @id @default(uuid())
  surveyId       String
  survey         Survey       @relation(fields: [surveyId], references: [id])
  surveyTitle    String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  status         String       @default("DRAFT")
  startDate      DateTime?
  endDate        DateTime?
  createdById    String?
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accessCode   String? @unique
  maxResponses Int?

  splashConfig Json?

  anonymousResponses AnonymousResponse[]

  @@index([surveyId])
  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([accessCode])
  @@map("survey_campaigns")
}

// ─── Anonymous Surveys ────────────────────────────────────────────────

model AnonymousResponse {
  id         String         @id @default(uuid())
  campaignId String
  campaign   SurveyCampaign @relation(fields: [campaignId], references: [id])

  sessionToken       String  @unique @default(uuid())
  ipHash             String?
  browserFingerprint String?

  demographics Json?

  flaggedForReview Boolean @default(false)
  flagReason       String?

  device       String?
  userAgent    String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  lastActiveAt DateTime  @default(now())

  responses AnonymousResponseItem[]

  @@index([campaignId])
  @@index([sessionToken])
  @@index([ipHash])
  @@index([browserFingerprint])
  @@map("anonymous_responses")
}

model AnonymousResponseItem {
  id                  String            @id @default(uuid())
  anonymousResponseId String
  anonymousResponse   AnonymousResponse @relation(fields: [anonymousResponseId], references: [id])

  questionId     String
  questionNumber Int
  value          Int?
  adjustedValue  Int?
  textValue      String?
  submittedAt    DateTime @default(now())

  @@unique([anonymousResponseId, questionId])
  @@index([anonymousResponseId])
  @@index([questionId])
  @@map("anonymous_response_items")
}
