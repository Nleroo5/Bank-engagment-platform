generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organizations ───────────────────────────────────────────────────────

model Organization {
  id              String   @id @default(uuid())
  name            String
  sizeRange       String?
  locationCountry String?
  locationState   String?
  locationMetro   String?
  locationCity    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users     User[]
  campaigns SurveyCampaign[]

  @@map("organizations")
}

// ─── Users ───────────────────────────────────────────────────────────────

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  name             String?
  passwordHash     String?
  role             String        @default("RESPONDENT") // SUPER_ADMIN | ORG_ADMIN | VIEWER | RESPONDENT
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  division         String?
  jobRole          String?
  employmentStatus String? // FULL_TIME | PART_TIME | PEAK_TIME
  gender           String? // FEMALE | MALE | OTHER
  timeAtBank       String?
  bankExperience   String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  invitations Invitation[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

// ─── Surveys (replacing Sanity) ──────────────────────────────────────────

model Survey {
  id           String  @id @default(uuid())
  title        String
  description  String?
  surveyType   String // 'likert3' | 'likert5'
  surveyNumber String? // e.g., 'Survey 4', 'Survey 5'

  // SurveyJS JSON schema (flexible storage)
  surveyjsSchema Json // Full SurveyJS survey definition

  status    String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  version   Int      @default(1)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  Section[]
  questions Question[]
  campaigns SurveyCampaign[]
  scale     Scale?           @relation(fields: [scaleId], references: [id])
  scaleId   String?

  @@index([status])
  @@index([surveyType])
  @@map("surveys")
}

model Section {
  id          String   @id @default(uuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]

  @@index([surveyId])
  @@map("sections")
}

model Question {
  id        String   @id @default(uuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  // Question content
  questionNumber Int
  text           String
  questionType   String // 'likert3' | 'likert5' | 'text' | 'select' | 'multiselect'

  // SurveyJS integration
  surveyjsName String // Matches name in SurveyJS schema (e.g., 'q1', 'q2')

  // Configuration (stored as JSON for flexibility)
  config Json? // { options: [], validation: {}, display: {} }

  // Flags
  isRequired Boolean @default(true)
  isReversed Boolean @default(false)

  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories QuestionCategory[]

  @@unique([surveyId, questionNumber])
  @@index([surveyId])
  @@index([sectionId])
  @@index([surveyjsName])
  @@map("questions")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  weight      Decimal  @default(1.0) @db.Decimal(4, 2)
  colorCode   String? // Hex color for UI
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions QuestionCategory[]

  @@map("categories")
}

model QuestionCategory {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([questionId, categoryId])
  @@index([questionId])
  @@index([categoryId])
  @@map("question_categories")
}

model Scale {
  id        String   @id @default(uuid())
  name      String   @unique
  scaleType String // 'likert3' | 'likert5'
  min       Int
  max       Int
  labels    Json // { "1": "Rarely", "2": "Sometimes", "3": "Frequently" }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  surveys Survey[]

  @@map("scales")
}

// ─── Survey Campaigns ────────────────────────────────────────────────────

model SurveyCampaign {
  id             String       @id @default(uuid())
  surveyId       String // Changed from sanitysurveyId
  survey         Survey       @relation(fields: [surveyId], references: [id])
  surveyTitle    String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  status         String       @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | ARCHIVED
  startDate      DateTime?
  endDate        DateTime?
  reminderDays   Int          @default(3)
  createdById    String?
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Anonymous survey fields
  isAnonymous  Boolean @default(false)
  accessCode   String? @unique
  maxResponses Int?

  // Splash / welcome screen customization
  splashConfig Json?

  invitations        Invitation[]
  anonymousResponses AnonymousResponse[]

  @@index([surveyId])
  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([accessCode])
  @@map("survey_campaigns")
}

// ─── Invitations ─────────────────────────────────────────────────────────

model Invitation {
  id             String         @id @default(uuid())
  campaignId     String
  campaign       SurveyCampaign @relation(fields: [campaignId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  token          String         @unique @default(uuid())
  status         String         @default("PENDING") // PENDING | SENT | OPENED | IN_PROGRESS | COMPLETED | EXPIRED
  sentAt         DateTime?
  openedAt       DateTime?
  completedAt    DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime       @default(now())

  // Demographics gate: set when this respondent has completed demographics for their org
  demographicsCompletedAt  DateTime?
  demographicsInvitationId String?

  session   ResponseSession?
  responses Response[]

  @@unique([campaignId, userId])
  @@index([token])
  @@index([campaignId])
  @@index([userId])
  @@map("invitations")
}

// ─── Response Sessions ───────────────────────────────────────────────────

model ResponseSession {
  id           String     @id @default(uuid())
  invitationId String     @unique
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  device       String?
  userAgent    String?
  ipHash       String?
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  lastActiveAt DateTime   @default(now())

  @@map("response_sessions")
}

// ─── Responses ───────────────────────────────────────────────────────────

model Response {
  id             String     @id @default(uuid())
  invitationId   String
  invitation     Invitation @relation(fields: [invitationId], references: [id])
  questionId     String // Changed from sanityQuestionId
  questionNumber Int
  value          Int? // For Likert scale responses (1-5 or 1-3) - RAW value as submitted
  adjustedValue  Int? // Value after reverse-scoring applied (if applicable)
  textValue      String? // For demographics text responses
  submittedAt    DateTime   @default(now())

  @@unique([invitationId, questionId])
  @@index([invitationId])
  @@index([questionId])
  @@map("responses")
}

// ─── Anonymous Surveys ────────────────────────────────────────────────

model AnonymousResponse {
  id         String         @id @default(uuid())
  campaignId String
  campaign   SurveyCampaign @relation(fields: [campaignId], references: [id])

  // Duplicate prevention (no user linkage)
  sessionToken       String  @unique @default(uuid())
  ipHash             String?
  browserFingerprint String?

  // Demographics stored as JSON (not on User table)
  demographics Json?

  // Fraud detection
  flaggedForReview Boolean @default(false)
  flagReason       String?

  // Metadata
  device       String?
  userAgent    String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  lastActiveAt DateTime  @default(now())

  responses AnonymousResponseItem[]

  @@index([campaignId])
  @@index([sessionToken])
  @@index([ipHash])
  @@index([browserFingerprint])
  @@map("anonymous_responses")
}

model AnonymousResponseItem {
  id                  String            @id @default(uuid())
  anonymousResponseId String
  anonymousResponse   AnonymousResponse @relation(fields: [anonymousResponseId], references: [id])

  questionId     String // Changed from sanityQuestionId
  questionNumber Int
  value          Int?
  adjustedValue  Int?
  textValue      String?
  submittedAt    DateTime @default(now())

  @@unique([anonymousResponseId, questionId])
  @@index([anonymousResponseId])
  @@index([questionId])
  @@map("anonymous_response_items")
}
