{
  "name": "bank-engagement-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-surveys": "tsx scripts/seed-sample-surveys.ts",
    "create-admin": "tsx create-admin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "validate:build": "npm run validate && npm run build",
    "pre-deploy": "npm run validate:build && npm run test",
    "audit": "tsx scripts/audit-code.ts",
    "audit:full": "npm run audit && npm run validate:build && npm run test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
