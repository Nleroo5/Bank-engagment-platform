# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bank_engagement?schema=public"

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN="your-api-token"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"

# hCaptcha (Optional - for bot protection on anonymous surveys)
# Sign up at https://www.hcaptcha.com/ to get keys
# If not configured, CAPTCHA verification will be skipped
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY="your-hcaptcha-site-key"
# HCAPTCHA_SECRET_KEY="your-hcaptcha-secret-key"

# Vercel Blob Storage (for campaign splash page logo uploads)
# Get from Vercel dashboard > Storage > Blob store > Connect
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"
