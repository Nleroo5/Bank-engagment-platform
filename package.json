    "pg": "^8.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.13.0",
    "resend": "^4.8.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
