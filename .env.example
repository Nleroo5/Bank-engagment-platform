# Database
# For Supabase: use the transaction pooler (port 6543) with ?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/bank_engagement?schema=public"
# Direct connection (bypasses PgBouncer) — used by Prisma for migrations
# For Supabase: use port 5432 (direct connection, not pooler)
DIRECT_URL="postgresql://user:password@localhost:5432/bank_engagement?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"  # Must be at least 32 characters
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"
