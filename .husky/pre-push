#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push validation..."

# Type check with increased memory
echo "📝 Type checking..."
NODE_OPTIONS=--max-old-space-size=16384 npm run type-check || { echo "❌ Type check failed! Fix errors before pushing."; exit 1; }

# Lint
echo "🔎 Linting..."
npm run lint || { echo "❌ Lint failed! Fix errors before pushing."; exit 1; }

# Build test (disabled due to memory issues - rely on CI/CD instead)
# echo "🏗️  Testing production build..."
# npm run build || { echo "❌ Build failed! Fix errors before pushing."; exit 1; }

echo "✅ All pre-push checks passed! Safe to push."
