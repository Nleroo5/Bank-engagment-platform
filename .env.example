# Database
# For Supabase: use the transaction pooler (port 6543) with ?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/bank_engagement?schema=public"
# Direct connection (bypasses PgBouncer) — used by Prisma for migrations
# For Supabase: use port 5432 (direct connection, not pooler)
DIRECT_URL="postgresql://user:password@localhost:5432/bank_engagement?schema=public"

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN="your-api-token"  # Requires read+write permissions on production dataset

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"  # Must be at least 32 characters
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"

# Vercel Blob Storage — No longer required: logos are now stored as base64 data URLs
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"
